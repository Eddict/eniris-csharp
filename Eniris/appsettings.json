{
  "Eniris": {
    "Username": "your-email@example.com",
    "SqlServerConnectionString": "Server=tcp:your-server.database.windows.net,1433;Initial Catalog=your-database;Persist Security Info=False;User ID=your-user;Password=your-password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;",
    "SqlServerBatchSizeLongRange": 5000,
    "AuthBaseUri": "https://authentication.eniris.be",
    "ApiBaseUri": "https://api.eniris.be"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Eniris": "Debug"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Eniris": "Debug"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/eniris-examples-.log",
          "rollingInterval": "Day",
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
